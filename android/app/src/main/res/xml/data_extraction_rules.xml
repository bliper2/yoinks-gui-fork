<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backups: keep settings/history, never the cookies file or partial downloads. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="queue.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="queue.json" />
    </device-transfer>
</data-extraction-rules>
