{
  "name": "yoinks-gui",
  "version": "2.4.1",
  "description": "Save videos and music from YouTube, YouTube Music, Spotify (via YouTube Music), SoundCloud, Bandcamp and 1,800+ sites. Desktop app + browser extension, built on yt-dlp.",
  "main": "main/main.js",
  "author": "mrkraps",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/pablostanley/yoinks",
  "scripts": {
    "start": "electron .",
    "dist": "npm run sync && electron-builder",
    "dist:win": "npm run sync && electron-builder --win --publish never",
    "extension:install": "node host/install.js",
    "extension:uninstall": "node host/install.js --uninstall",
    "test": "node --test",
    "sync": "node scripts/sync-changelog.js",
    "package:extension": "node scripts/package-extension.js",
    "announce": "node scripts/discord-announce.js",
    "dist:linux": "npm run sync && electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.mrkraps.yoinks-gui",
    "productName": "Yoinks",
    "asar": true,
    "files": [
      "main/**/*",
      "core/**/*",
      "host/**/*",
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      "preload.js",
      "package.json",
      "!**/*.map",
      "!host/com.yoinks.host*.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "extraResources": [
        {
          "from": "ffmpeg.exe",
          "to": "ffmpeg.exe"
        },
        {
          "from": "ffprobe.exe",
          "to": "ffprobe.exe"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bliper2",
        "repo": "yoinks-gui-fork"
      }
    ],
    "afterPack": "build/after-pack.js",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "yoinks",
      "icon": "build/icon.png",
      "category": "AudioVideo;Network",
      "synopsis": "Save videos and music from YouTube and 1,800+ sites",
      "maintainer": "mrkraps <noreply@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "ffmpeg",
          "to": "ffmpeg"
        },
        {
          "from": "ffprobe",
          "to": "ffprobe"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Yoinks",
          "Comment": "Save videos and music from YouTube and 1,800+ sites",
          "Keywords": "video;music;download;youtube;yt-dlp;",
          "StartupWMClass": "Yoinks"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  }
}
