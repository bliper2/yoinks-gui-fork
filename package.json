{
  "name": "yoinks-gui",
  "version": "2.2.0",
  "description": "Save videos and music from YouTube, YouTube Music, Spotify (via YouTube Music), SoundCloud, Bandcamp and 1,800+ sites. Desktop app + browser extension, built on yt-dlp.",
  "main": "main/main.js",
  "author": "mrkraps",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/pablostanley/yoinks",
  "scripts": {
    "start": "electron .",
    "dist": "npm run sync && electron-builder",
    "dist:win": "npm run sync && electron-builder --win --publish never",
    "extension:install": "node host/install.js",
    "extension:uninstall": "node host/install.js --uninstall",
    "test": "node --test",
    "sync": "node scripts/sync-changelog.js",
    "package:extension": "node scripts/package-extension.js",
    "announce": "node scripts/discord-announce.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.mrkraps.yoinks-gui",
    "productName": "Yoinks",
    "asar": true,
    "files": [
      "main/**/*",
      "core/**/*",
      "host/**/*",
      "extension/**/*",
      "preload.js",
      "package.json",
      "!**/*.map",
      "!host/com.yoinks.host*.json"
    ],
    "extraResources": [
      {
        "from": "ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "ffprobe.exe",
        "to": "ffprobe.exe"
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bliper2",
        "repo": "yoinks-gui-fork"
      }
    ],
    "afterPack": "build/after-pack.js"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  }
}
