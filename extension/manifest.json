{
  "manifest_version": 3,
  "name": "Yoinks",
  "version": "2.3.1",
  "description": "Save videos and music from YouTube, YouTube Music, SoundCloud, Bandcamp and 1,800+ sites to your PC. Uses yt-dlp through the Yoinks helper.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared/settings-schema.js",
      "shared/filename-template.js",
      "shared/formats.js",
      "shared/sites.js",
      "shared/schedule.js",
      "shared/controller.js",
      "background.js"
    ]
  },
  "options_page": "app.html?view=settings",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*",
        "https://*.bandcamp.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://vimeo.com/*",
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*",
        "https://open.spotify.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.dailymotion.com/*",
        "https://streamable.com/*",
        "https://rumble.com/*"
      ],
      "js": [
        "shared/sites.js",
        "content/button.js",
        "content/mounts.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "Open Yoinks on this tab"
    }
  },
  "action": {
    "default_popup": "app.html",
    "default_title": "Yoinks (Alt+Y)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yoinks@yoinks.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
